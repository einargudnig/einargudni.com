{
  "$schema": "https://oxc.rs/schema/.oxlintrc.json",
  "plugins": ["react", "typescript", "import"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_splat", "_tag"]
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  }
}

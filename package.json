{
  "name": "einar-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "velite --watch & vite dev",
    "build": "velite && bun run og && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "og": "bun scripts/generate-og.mjs",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "check": "oxlint && bun run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cf-typegen": "wrangler types",
    "convex:dev": "convex dev",
    "quotes": "cd tools/quotes-tui && bun run start",
    "pretypecheck": "velite"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.50",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.5",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.15.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-wrap-balancer": "^1.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^3.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/bun": "^1.3.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.53.0",
    "remark-frontmatter": "^5.0.0",
    "satori": "^0.29.0",
    "shiki": "^3.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "velite": "^0.3.0",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }

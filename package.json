{
  "name": "einargudni.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.ts",
    "#content/*": "./src/content/*.ts",
    "#pages/*": "./src/pages/*.ts"
  },
  "scripts": {
    "dev": "velite --watch & vite dev",
    "build": "velite && bun run og && vite build",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "og": "bun scripts/generate-og.mjs",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cf-typegen": "wrangler types",
    "convex:dev": "convex dev",
    "quotes": "cd tools/quotes-tui && bun run start",
    "pretypecheck": "velite"
  },
  "dependencies": {
    "@effect/ui": "file:./vendor/effect-ui-859a30f.tgz",
    "@effect/ui-kit": "file:./vendor/effect-ui-kit-859a30f.tgz",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "convex": "^1.31.5",
    "effect": "4.1.4",
    "lucide": "^1.81.0",
    "maplibre-gl": "^5.15.0",
    "postgres": "^3.4.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.6",
    "@types/node": "^24",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.53.0",
    "satori": "^0.29.0",
    "shiki": "^3.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "velite": "^0.3.0",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "@effect/ui": "file:./vendor/effect-ui-859a30f.tgz"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "einargudni-com",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // /blog/tmux serves /blog/tmux.html. No not_found_handling: unmatched
    // paths must reach the Worker, which owns the endpoints and the 404 page.
    "html_handling": "auto-trailing-slash",
    // Assets are served before the Worker by default, which would hide these
    // paths from the Accept: text/markdown negotiation in src/worker.ts.
    // Mirrors the matcher the Next middleware used.
    "run_worker_first": ["/", "/blog/*", "/deep-dive/*", "/use-cases/*"],
  },
  // www is caught first by a Redirect Rule (301 -> apex); attaching it here
  // just gives the hostname a record and a certificate.
  "routes": [
    { "pattern": "einargudni.com", "custom_domain": true },
    { "pattern": "www.einargudni.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
  },
}
